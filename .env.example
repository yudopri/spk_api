PORT=5000
JWT_SECRET=replace_with_secure_key
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d
AUTO_SEED_PERMISSIONS=false
MOORA_BATCH_SIZE=500
INSERT_BATCH_SIZE=500
LARAVEL_APP_KEY_BASE64=replace_with_laravel_key
DB_TIMEOUT_MS=8000
DB_MAX_RETRIES=2

# Mitra DB (Supabase Project 1)
MITRA_SUPABASE_URL=https://your-mitra-project.supabase.co
MITRA_SUPABASE_KEY=your-mitra-anon-or-service-role-key

# SPK DB (Supabase Project 2)
SPK_SUPABASE_URL=https://your-spk-project.supabase.co
SPK_SUPABASE_KEY=your-spk-anon-or-service-role-key
